# Required: create a bot with @BotFather
BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE
# Your numeric Telegram user ID(s), comma-separated
ADMIN_IDS=123456789
# Optional: source channel numeric ID, usually starts with -100
SOURCE_CHANNEL_ID=-1001234567890
# Optional: comma-separated channel usernames/IDs for force subscribe
FSUB_CHANNELS=@YourChannel
# Optional: invite/public links in same order as FSUB_CHANNELS
FSUB_LINKS=https://t.me/YourChannel
# Force subscribe default: true or false. Admin can also use /fsub on|off at runtime.
FSUB_ENABLED=true
# Koyeb health-check HTTP port; keep 8000 and configure exposed port to 8000
PORT=8000
# Recommended for permanent data: MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=anime_vault
# Optional PostgreSQL fallback only if MONGO_URI is blank
DATABASE_URL=
# Optional fallback only when DATABASE_URL is blank (local SQLite; may be ephemeral on Koyeb)
DB_PATH=animebot.db
